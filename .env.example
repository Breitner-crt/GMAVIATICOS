# ------------------------------------------------------------------
# Acceso a la app
# ------------------------------------------------------------------
# Código que pedirá la app para entrar (elige uno tuyo, largo).
APP_PASSCODE=cambia-este-codigo

# Clave para firmar la sesión. Genera una cadena aleatoria larga.
APP_SECRET=cambia-esta-clave-secreta-de-32-caracteres-o-mas

# ------------------------------------------------------------------
# Google Sheet
# ------------------------------------------------------------------
SHEET_ID=1Ezz6wbEu4f3k8h-kpB8HWvcEP6ZYyATHwNddb0NxCvI
SHEET_TAB=FORMATO DE LIQUIDACION

# SHEET_ID es solo la hoja inicial: dentro de la app puedes cambiar de hoja
# (botón "Hoja de cálculo") sin volver a desplegar.

# Opción A (recomendada): cuenta de servicio.
# Pega el JSON completo de la cuenta de servicio, o su versión en base64.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Opción B (alternativa): webhook de Apps Script.
# Si defines estas dos, la app usa el webhook en lugar de la cuenta de servicio.
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# SHEETS_WEBHOOK_TOKEN=un-token-largo-compartido-con-el-script

# ------------------------------------------------------------------
# OCR de fotografías (Google AI Studio / Gemini)
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------
# Modo demostración (opcional)
# ------------------------------------------------------------------
# Con DEMO_MODE=1 la app usa datos falsos en memoria y no toca el Sheet.
DEMO_MODE=0
